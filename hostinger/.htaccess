# Fusora — Hostinger Apache (SPA + PHP OTP)

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Keep real files/dirs (assets, api/*.php)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # OTP API endpoints
  RewriteRule ^api/otp/send/?$ api/otp/send.php [L,QSA]
  RewriteRule ^api/otp/verify/?$ api/otp/verify.php [L,QSA]

  # React Router SPA fallback
  RewriteRule ^ index.html [L]
</IfModule>

# Cache hashed assets
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|png|jpg|jpeg|webp|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
